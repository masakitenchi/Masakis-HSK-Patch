<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- ========== Archomutt ========== -->
			<!-- ========== Archostrich ========== -->
			<!-- ========== Archolope ========== -->
			<!-- ========== Archojerboa ========== -->
			<!-- ========== Archotortoise ========== -->
			<!-- ========== Archocat ========== -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Archocat" or 
					defName="Archomutt" or 
					defName="Archolope" or 
					defName="Archojerbos" or 
					defName="Archotortoise"]/race/useMeatFrom</xpath>
				<value>
					<useMeatFrom>Elephant</useMeatFrom>
				</value>
			</li>
			<!-- ========== Archothrumbo ========== -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Archothrumbo"]/race/useMeatFrom</xpath>
				<value>
					<useMeatFrom>Muffalo</useMeatFrom>
				</value>
			</li>
			<!-- ========== Archopanda ========== -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Archopanda"]/race/useMeatFrom</xpath>
				<value>
					<useMeatFrom>Muffalo</useMeatFrom>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Archopanda"]/race/leatherDef</xpath>
				<value>
					<leatherDef>Leather_Heavy</leatherDef>
				</value>
			</li>

			<!-- ========== Plant_Meatbush ========== -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="Plant_Meatbush"]/plant/harvestedThingDef</xpath>
				<value>
					<harvestedThingDef>Meat_Muffalo</harvestedThingDef>
				</value>
			</li>
			<!-- ========== weaponMoney ========== -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/PawnKindDef[defName="SpaceCrew"]/weaponMoney</xpath>
				<value>
					<weaponMoney>1300~1500</weaponMoney>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/PawnKindDef[defName="SpaceCrewEVA"]/weaponMoney</xpath>
				<value>
					<weaponMoney>1300~1500</weaponMoney>
				</value>
			</li>
			<!-- <li Class="PatchOperationReplace">
					<xpath>Defs/PawnKindDef[defName="SpaceCrewMarine"]/weaponMoney</xpath>
					<value>
						<weaponMoney>1500~1800</weaponMoney>
					</value>
				</li> -->
			<!-- ========== SoilShip ========== -->

			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/TerrainDef[defName="SoilShip"]</xpath>
				<value Merge="true">
					<statBases Merge="true">
						<WorkToBuild>2000</WorkToBuild>
					</statBases>
					<costList DeepReplace="true">
						<Dirt>40</Dirt>
						<CrushedStone>20</CrushedStone>
						<SoftClay>20</SoftClay>
						<Peat>20</Peat>
						<SandResource>20</SandResource>
						<Fertilizer>20</Fertilizer>
					</costList>
				</value>
			</li>
			<!-- Remove legacy designator fields only when the current SOS2 branch still defines them. -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[@Name="ShipCorner" or @Name="ShipCornerArchotech"]/designatorDropdown |
						Defs/ThingDef[@Name="ShipHardpoint"]/constructEffect |
						Defs/ThingDef[@Name="ShipHardpoint"]/designatorDropdown |
						Defs/ThingDef[@Name="BaseShipTorpedoBuilding"]/designatorDropdown |
						Defs/ThingDef[@Name="ShipHeatsinkBase"]/constructEffect |
						Defs/ThingDef[@Name="ShipHeatsinkBase"]/designatorDropdown</xpath>
				<match Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[@Name="ShipCorner" or @Name="ShipCornerArchotech"]/designatorDropdown |
							Defs/ThingDef[@Name="ShipHardpoint"]/constructEffect |
							Defs/ThingDef[@Name="ShipHardpoint"]/designatorDropdown |
							Defs/ThingDef[@Name="BaseShipTorpedoBuilding"]/designatorDropdown |
							Defs/ThingDef[@Name="ShipHeatsinkBase"]/constructEffect |
							Defs/ThingDef[@Name="ShipHeatsinkBase"]/designatorDropdown</xpath>
				</match>
			</li>
			<!-- Torpedo market values -->
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="ShipTorpedo_HighExplosive"]</xpath>
				<value Merge="true">
					<statBases Merge="true">
						<MarketValue>2000</MarketValue>
					</statBases>
				</value>
			</li>
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="ShipTorpedo_EMP"]</xpath>
				<value Merge="true">
					<statBases Merge="true">
						<MarketValue>1500</MarketValue>
					</statBases>
				</value>
			</li>
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="ShipTorpedo_Antimatter"]</xpath>
				<value Merge="true">
					<statBases Merge="true">
						<MarketValue>5000</MarketValue>
					</statBases>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>