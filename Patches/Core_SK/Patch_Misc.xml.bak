<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<!-- Integrated into Core_SK -->
	<!-- <Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="SK_BasePawn"]/comps</xpath>
		<value>
			<li>
				<compClass>Core_SK_Patch.ManualCastOverride</compClass>
			</li>
		</value>
	</Operation> -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="DeepDrill"]/comps</xpath>
		<value>
			<li>
				<compClass>Core_SK_Patch.CompBillableDrill</compClass>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Extractor" or defName="RareExtractor"]/comps</xpath>
		<value>
			<li>
				<compClass>Core_SK_Patch.CompAutoExtractorLimit</compClass>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="SandResource"]</xpath>
		<value>
			<deepCountPerPortion>50</deepCountPerPortion>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="CrushedStone"]</xpath>
		<value>
			<deepCountPerPortion>30</deepCountPerPortion>
		</value>
	</Operation>

</Patch>
