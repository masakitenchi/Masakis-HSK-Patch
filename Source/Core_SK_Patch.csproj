<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RuntimeIdentifiers>win;linux</RuntimeIdentifiers>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version Condition="'$(Version)' == ''">1.6</Version>
    <OutputPath>..\v$(Version)\Assemblies\</OutputPath>
    <AssemblyTitle>Core_SK_Patch</AssemblyTitle>
    <Product>Main</Product>
    <Copyright>Copyright ©  2024</Copyright>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>pdbonly</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'"> -->
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Version)' == '1.5'">
    <DefineConstants>$(DefineConstants);RW_1_5</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*" />
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- All Obsolete Codes Are Stored Here-->
    <Compile Remove="Obsolete\**" />

    <Compile Remove="SeedsPleaseCompat\**" />
    <Compile Remove="SOS2Compat\**" />
    <Compile Remove="StatPart\StatPart_Upgradeable.cs" />
    <Compile Remove="Patches\RimThemesCharacterEditorWindowFix.cs" />
    <Compile Remove="ResearchReinvented\**" />
    <Compile Remove="RimThemesCharacterEditorCompat\**" />
    <Compile Remove="AnomalyCompat\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(Version)' == '1.5'">
    <!-- Fishing and water-body APIs are provided by Odyssey in RimWorld 1.6. -->
    <Compile Remove="Patches\Patch_TerraformWaterFish.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CombatExtended">
      <HintPath>..\..\CombatExtended\Assemblies\CombatExtended.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core_SK">
      <HintPath>..\..\Core_SK\Assemblies\Core_SK.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>