<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Preserve SOS2 1.6 ScenarioBase inheritance and its namespaced ScenPart. -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ScenarioDef[defName="SoSDerelict" or defName="SoSDungeon"]/scenario/parts/li[(def="StartingThing_Defined" and (thingDef="Silver" or thingDef="ComponentIndustrial" or thingDef="Gun_BoltActionRifle" or thingDef="Gun_Revolver" or thingDef="Apparel_FlakPants" or thingDef="Apparel_FlakVest" or thingDef="Apparel_AdvancedHelmet" or thingDef="Ammo_303British_FMJ" or thingDef="Ammo_44Magnum_FMJ" or thingDef="Ammo_6x24mmCharged")) or (def="StartingResearch" and project="ShipBasics")]</xpath>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ScenarioDef[defName="SoSDerelict"]/scenario/parts</xpath>
				<value>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>TFJ_Tool_Multitool</thingDef>
						<stuff>Plasteel</stuff>
						<count>4</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Gun_MP5Gun</thingDef>
						<count>1</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Gun_PumpShotgun</thingDef>
						<count>1</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>RF_Gun_AT2K</thingDef>
						<count>3</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Ammo_9x19mmPara_FMJ</thingDef>
						<count>600</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Ammo_12Gauge_Buck</thingDef>
						<count>200</count>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ScenarioDef[defName="SoSDungeon"]/scenario/parts</xpath>
				<value>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>TFJ_Tool_Multitool</thingDef>
						<stuff>Plasteel</stuff>
						<count>4</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Gun_MP5Gun</thingDef>
						<count>1</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Gun_PumpShotgun</thingDef>
						<count>1</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>RF_Gun_AT2K</thingDef>
						<count>3</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Ammo_9x19mmPara_FMJ</thingDef>
						<count>600</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Ammo_12Gauge_Buck</thingDef>
						<count>200</count>
					</li>
				</value>
			</li>
			<!-- Three-pawn space starts: complete EVA sets and an HSK emergency repair reserve.
			     Template loot is extra, not the source of guaranteed starting equipment.
			     StartingResearch completes HSK prerequisites through the vanilla API.
			     Do not apply to Load Ship (imported research/cargo) or Afterlife Vault
			     (surface formgels and deliberately limited power, not a vacuum start). -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ScenarioDef[defName="SoSDerelict" or defName="SoSDungeon"]/scenario/parts</xpath>
				<value>
					<li Class="ScenPart_StartingResearch">
						<def>StartingResearch</def>
						<project>ShipBasics</project>
					</li>
					<li Class="ScenPart_StartingResearch">
						<def>StartingResearch</def>
						<project>ShipLifeSupport</project>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Apparel_SpaceSuitBody</thingDef>
						<stuff>Synthread</stuff>
						<count>3</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Apparel_SpaceSuitHelmet</thingDef>
						<stuff>Synthread</stuff>
						<count>3</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Steel</thingDef>
						<count>400</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>ComponentAdvanced</thingDef>
						<count>40</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>ComponentSpacer</thingDef>
						<count>8</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Electronics</thingDef>
						<count>8</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>AdvMechanism</thingDef>
						<count>2</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Wire</thingDef>
						<count>200</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Glass</thingDef>
						<count>80</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Plastic</thingDef>
						<count>60</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Dirt</thingDef>
						<count>80</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>Chemfuel</thingDef>
						<count>100</count>
					</li>
					<li Class="ScenPart_StartingThing_Defined">
						<def>StartingThing_Defined</def>
						<thingDef>HullFoam</thingDef>
						<count>60</count>
					</li>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
