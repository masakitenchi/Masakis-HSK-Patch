<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Combat tools are supplied by Combat Extended's SOS2 patches. -->
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- HSK meat families. Raw hides remain owned by Hell Bent for Leather Tanning. -->
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="Hide_RichFurPelt"]</xpath>
				<!-- Only use finished leather when the tanning raw-hide Def is absent. -->
				<nomatch Class="SK.PatchOperationReplaceExtended">
					<xpath>Defs/ThingDef[defName="Archopanda"]</xpath>
					<value Merge="true">
						<race Merge="true"><leatherDef>Leather_Heavy</leatherDef></race>
					</value>
				</nomatch>
			</li>
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="Archocat" or defName="Archomutt" or defName="Archolope" or defName="Archojerboa" or defName="Archotortoise"]</xpath>
				<value Merge="true"><race Merge="true"><useMeatFrom>Elephant</useMeatFrom></race></value>
			</li>
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="Archothrumbo" or defName="Archopanda"]</xpath>
				<value Merge="true"><race Merge="true"><useMeatFrom>Muffalo</useMeatFrom></race></value>
			</li>

			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="Archoffalo"]</xpath>
				<value Merge="true">
					<!-- Match HSK muffalo milk production; keep SOS2's hyperweave shearing. -->
					<comps Merge="true">
						<li Class="CompProperties_Milkable">
							<milkDef>Milk</milkDef>
							<milkIntervalDays>1</milkIntervalDays>
							<milkAmount>13</milkAmount>
							<milkFemaleOnly>true</milkFemaleOnly>
						</li>
					</comps>
				</value>
			</li>
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="Archostrich"]</xpath>
				<value Merge="true">
					<race Merge="true">
						<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
						<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
						<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
					</race>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
