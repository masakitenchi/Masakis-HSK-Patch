<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Save Our Ship 2</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- Keep CE's SOS2-specific verb properties after HSK's generic gun conversion. -->
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef/verbs/li[defaultProjectileGround and verbClass="CombatExtended.Compatibility.SOS2Compat.Verb_ShootShipCE" and not(@Class="CombatExtended.Compatibility.SOS2Compat.VerbPropertiesShipWeaponCE")]</xpath>
					<match Class="PatchOperationAttributeSet">
						<xpath>Defs/ThingDef/verbs/li[defaultProjectileGround and verbClass="CombatExtended.Compatibility.SOS2Compat.Verb_ShootShipCE"]</xpath>
						<attribute>Class</attribute>
						<value>CombatExtended.Compatibility.SOS2Compat.VerbPropertiesShipWeaponCE</value>
					</match>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
